{
  "name": "rs3-nexus",
  "version": "1.0.0",
  "description": "An Enhanced Version of Alt1 for RuneScape 3 - Desktop Application",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "keywords": [
    "runescape",
    "rs3",
    "alt1",
    "gaming",
    "desktop",
    "electron"
  ],
  "author": "RS3-Nexus Team",
  "license": "Apache-2.0",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3",
    "idb": "^8.0.0",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.rs3nexus.app",
    "productName": "RS3-Nexus",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/assets/icon.png"
    }
  }
}
